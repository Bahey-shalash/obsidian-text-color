{
	"name": "obsidian-text-color",
	"version": "1.0.0",
	"description": "Color text in Obsidian with hex-based markup; lean fork of Fast Text Color",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest",
		"lint": "eslint src test --ext .ts",
		"grammar": "node ./node_modules/@lezer/generator/src/lezer-generator.cjs ./src/parser/textColorLanguage.grammar -o ./src/parser/textColorLanguageParser.js"
	},
	"keywords": [],
	"author": "Bahey Shalash",
	"license": "GPL-3.0",
	"devDependencies": {
		"@lezer/generator": "^1.7.0",
		"@types/jest": "^29.5.12",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"eslint": "^8.51.0",
		"jest": "^29.7.0",
		"jsdom": "^24.1.3",
		"obsidian": "latest",
		"sass": "^1.94.2",
		"ts-jest": "^29.1.2",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@codemirror/language": "^6.10.1"
	}
}
