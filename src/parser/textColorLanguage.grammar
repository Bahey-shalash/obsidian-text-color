@top TextColor { (char|Expression|Unfinished|ENDLN|RMarker|CodeSection)* }

CodeSection { CODE (char|Expression|Unfinished|ENDLN|RMarker)* CODE }

Expression { TcLeft TcRight }

TcLeft { LMarker Description }

TcRight { Text REnd | Text? (Expression Text?)+ REnd }

Description { Color? InnerMarker}

Unfinished { LMarker Color? (ColorEOF | ColorWS)
           | TcLeft REnd }

REnd { RMarker | ENDLN | EOF }

Text { Word | Word? (CodeSection Word?)+ }

Word { char+ }

// `=~` is read by hand because the marker it closes can be standing right
// behind it: in `==~={red}text=~==` the `=` obsidian's highlight leaves in
// front of the opening marker pairs with that marker's own `~` into a perfect
// `=~`, and a plain token rule takes it: opener gone, the whole expression
// with it. The tokenizer below refuses a `=~` whose `~` starts a `~={`, which
// is the same rule `markers.ts` applies to the reading mode regexes.
@external tokens closeMarker from "./closeMarker" { RMarker }

@tokens {
  LMarker { "~={" }
  EOF { @eof }
  ENDLN { "\n\n" }

  char { $[\n\r\t\u{20}\u{21}\u{23}-\u{5b}\u{5d}-\u{5f}\u{61}-\u{10ffff}\\"] | "\\" esc | "\\\u{60}"}

  CODE {"`"}

  esc  { $["\\\/bfnrt] | "u" hex hex hex hex }
  hex  { $[0-9a-fA-F] }
}

@local tokens {
  InnerMarker { "}" }
  ColorEOF { @eof }
  ColorWS { @whitespace }
  @else Color
}
